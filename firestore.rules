
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // --- Collection: users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isRole('admin') || isRole('kepala_sekolah');
      // allow list for aggregation and admin/kepsek browsing
      allow list: if isRole('admin') || isRole('kepala_sekolah');
      allow create: if isRole('admin');
      allow update: if isOwner(userId) || isRole('admin');
      allow delete: if isRole('admin');
    }

    // --- Sub-collections under users (attendanceRecords & leaveRequests) ---
    match /users/{userId}/{subCollection}/{docId} {
      allow read: if isOwner(userId) || isRole('admin') || isRole('kepala_sekolah');
      allow create: if isOwner(userId) || isRole('admin');
      allow update: if isOwner(userId) || isRole('admin') || (subCollection == 'leaveRequests' && isRole('kepala_sekolah'));
      allow delete: if isOwner(userId) || isRole('admin');
    }
    
    // --- Collection Group Rules (Dashboard & Stats) ---
    match /{path=**}/attendanceRecords/{docId} {
      allow read, list: if isRole('admin') || isRole('kepala_sekolah') || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }
    
    match /{path=**}/leaveRequests/{docId} {
      allow read, list: if isRole('admin') || isRole('kepala_sekolah') || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }
    
    // --- Global Configuration ---
    match /schoolConfig/{docId} {
      allow read: if isAuthenticated();
      allow write: if isRole('admin');
    }

    match /monthlyConfigs/{docId} {
      allow read: if isAuthenticated();
      allow write: if isRole('admin');
    }

    match /quotes/{quoteId} {
      allow read: if isAuthenticated();
      allow write: if isRole('admin');
    }
  }
}
