rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Function ---
    // Membaca data role user langsung dari dokumen profilnya
    function isRole(role) {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Helper untuk mengecek kepemilikan dokumen
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // --- Collection: users ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isRole('admin') || isRole('kepala_sekolah');
      allow list: if isRole('admin') || isRole('kepala_sekolah');
      allow create: if isRole('admin');
      allow update: if isOwner(userId) || isRole('admin');
      allow delete: if isRole('admin');
    }

    // --- Rules untuk Sub-collections (attendanceRecords & leaveRequests) ---
    // Aturan ini mendukung akses langsung via path /users/{userId}/...
    match /users/{userId}/{subCollection}/{docId} {
      allow read: if isOwner(userId) || isRole('admin') || isRole('kepala_sekolah');
      allow create: if isOwner(userId) || isRole('admin');
      allow update: if isOwner(userId) || isRole('admin') || (subCollection == 'leaveRequests' && isRole('kepala_sekolah'));
      allow delete: if isOwner(userId) || isRole('admin');
    }
    
    // --- KHUSUS COLLECTION GROUP QUERIES (Dashboard & Laporan Sekolah) ---
    // Rules ini wajib ada agar kueri "collectionGroup" tidak dianggap melanggar izin.
    match /{path=**}/attendanceRecords/{docId} {
      allow read, list: if isRole('admin') || isRole('kepala_sekolah') || (request.auth != null && request.auth.uid == resource.data.userId);
    }
    
    match /{path=**}/leaveRequests/{docId} {
      allow read, list: if isRole('admin') || isRole('kepala_sekolah') || (request.auth != null && request.auth.uid == resource.data.userId);
    }
    
    // --- Global Configuration ---
    match /schoolConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if isRole('admin');
    }

    match /monthlyConfigs/{docId} {
      allow read: if request.auth != null;
      allow write: if isRole('admin');
    }

    match /quotes/{quoteId} {
      allow read: if request.auth != null;
      allow write: if isRole('admin');
    }
  }
}